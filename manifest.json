{
  "manifest_version": 3,
  "name": "GitHub Notification Diffstat",
  "version": "0.1.0",
  "description": "Shows +additions −deletions and diffstat blocks for pull requests on github.com/notifications and github.com/pulls.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://patch-diff.githubusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["diffstat.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
